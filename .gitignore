# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit actual env files — only .env.example is safe to commit
# NOTE: .gitignore does NOT support inline trailing comments — a pattern like
# ".env.prod  # comment" is matched LITERALLY (including the comment text),
# so it silently matches nothing. Previously ".env.prod" had exactly this bug
# and was never actually ignored. Keep each pattern on its own line, with any
# explanation on the line above as a full-line comment.
.env
.env.local
.env.*.local
.env.prod
.env.staging

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── TypeScript build output ───────────────────────────────────────────────────
dist/
dist-test/
build/
*.tsbuildinfo

# ── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
dashboard/.next/
dashboard/out/

# ── Test & Coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Docker ────────────────────────────────────────────────────────────────────
# Ignore any local docker override files (e.g. docker-compose.override.yml
# with developer-specific port overrides) but keep tracked compose files.
docker-compose.override.yml

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
nginx/logs/

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.vscode/settings.json     # Machine-specific VS Code settings (keep extensions.json)
.idea/
*.swp
*.swo
*~

# ── Supabase ──────────────────────────────────────────────────────────────────
supabase/.temp/
supabase/migrations/.migrate

# ── n8n ───────────────────────────────────────────────────────────────────────
# n8n's local data directory (created when running n8n outside Docker)
.n8n/

# ── Certificates (managed on host, not in repo) ───────────────────────────────
nginx/certs/
*.pem
*.key
*.crt
*.p12
