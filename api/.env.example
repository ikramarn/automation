# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Supabase project URL (found in Supabase dashboard > Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT (Supabase JWT secret — found in Supabase dashboard > Settings > API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cookie secret (at least 32 chars, randomly generated)
COOKIE_SECRET=your-cookie-secret-at-least-32-chars

# CORS
CORS_ORIGIN=http://localhost:3000

# App URLs (used for email redirect links)
APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000/dashboard
EMAIL_REDIRECT_TO=http://localhost:3000/verify-email
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Google OAuth callback URLs
# Used by /auth/google (login flow) — Supabase Auth redirects here after Google consent
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3001/auth/google/callback
# Used by /credentials/google/connect (Drive OAuth flow) — Google redirects here after Drive consent
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:3001/credentials/google/callback
