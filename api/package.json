{
  "name": "ai-video-automation-api",
  "version": "0.1.0",
  "description": "AI Video Automation SaaS — Backend API (Fastify + TypeScript)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/jwt": "8.0.1",
    "@supabase/supabase-js": "2.43.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "3.1.3",
    "fastify": "4.26.2",
    "fastify-plugin": "4.5.1",
    "jose": "5.9.6",
    "pino": "8.19.0",
    "pino-pretty": "11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "3.5.0",
    "stripe": "^15.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.3.0",
    "@types/node": "20.12.12",
    "@typescript-eslint/eslint-plugin": "7.10.0",
    "@typescript-eslint/parser": "7.10.0",
    "@vitest/coverage-v8": "1.6.0",
    "eslint": "8.57.0",
    "fast-check": "3.22.0",
    "tsx": "4.11.0",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
