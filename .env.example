# ══════════════════════════════════════════════════════════════════════════════
# AI Video Automation SaaS — Environment Variable Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env (development) or .env.prod (production).
# NEVER commit .env or .env.prod to version control.
#
# Required variables are marked [REQUIRED].
# Optional variables with sensible defaults are marked [OPTIONAL].
# Production-only variables are marked [PROD].

# ── Application ───────────────────────────────────────────────────────────────

DOMAIN=localhost                               # [REQUIRED] [PROD: your actual domain]
DASHBOARD_URL=http://localhost:3000            # [REQUIRED]
API_URL=http://localhost/api                   # [REQUIRED]

# ── Fastify API Server ────────────────────────────────────────────────────────

PORT=3001                                      # [OPTIONAL]
HOST=0.0.0.0                                   # [OPTIONAL]
NODE_ENV=development                           # [REQUIRED] development | production | test

# Generate with: openssl rand -hex 32
COOKIE_SECRET=replace-with-a-random-32-char-minimum-string  # [REQUIRED]

CORS_ORIGIN=http://localhost:3000              # [REQUIRED]

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase migrated to new API key format in 2025.
# New keys: sb_publishable_... (client) and sb_secret_... (server)
# Legacy keys (anon / service_role) still work during transition.
#
# Found in: Supabase Dashboard → Settings → API Keys

# Project URL — public, safe to expose to browser
SUPABASE_URL=https://your-project-ref.supabase.co          # [REQUIRED]
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co  # [REQUIRED] Next.js client

# Publishable key (new format: sb_publishable_...) — replaces anon key
# Safe to expose to browser — RLS enforces access control
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key           # [REQUIRED] API server
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key  # [REQUIRED] Next.js client

# Secret key (new format: sb_secret_...) — replaces service_role key
# SERVER SIDE ONLY — never expose to browser — bypasses RLS
SUPABASE_SECRET_KEY=sb_secret_your-key                     # [REQUIRED]

# Legacy keys — kept for backward compatibility, can be left empty if using new keys
SUPABASE_ANON_KEY=                                         # [OPTIONAL] legacy
NEXT_PUBLIC_SUPABASE_ANON_KEY=                             # [OPTIONAL] legacy
SUPABASE_SERVICE_ROLE_KEY=                                 # [OPTIONAL] legacy

# JWT secret — only needed if using legacy HS256 signing (old projects)
# New projects use JWKS endpoint auto-derived from SUPABASE_URL — no secret needed
SUPABASE_JWT_SECRET=                                       # [OPTIONAL] legacy only

# ── Stripe ────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key           # [REQUIRED]
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret     # [REQUIRED]
STRIPE_PRICE_ID=price_your-stripe-price-id                 # [REQUIRED]
STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success   # [REQUIRED]
STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?checkout=cancelled  # [REQUIRED]

# ── n8n Pipeline Engine ───────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
N8N_SERVICE_TOKEN=replace-with-a-random-32-char-minimum-string  # [REQUIRED]
N8N_API_KEY=your-n8n-api-key                               # [REQUIRED]
N8N_API_URL=http://n8n:5678/api/v1                         # [REQUIRED]

# ── Resend (Transactional Email) ──────────────────────────────────────────────

RESEND_API_KEY=re_your-resend-api-key                      # [REQUIRED]
RESEND_FROM_EMAIL=AI Video Automation <noreply@yourdomain.com>  # [REQUIRED]

# ── Google OAuth ──────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com   # [REQUIRED]
GOOGLE_CLIENT_SECRET=your-google-client-secret                       # [REQUIRED]
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3001/auth/google/callback  # [REQUIRED]
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:3001/credentials/google/callback  # [REQUIRED]
SOCIAL_OAUTH_REDIRECT_URL_YOUTUBE=http://localhost:3001/credentials/social/youtube/callback   # [REQUIRED]

# ── TikTok OAuth ──────────────────────────────────────────────────────────────
# Get these from: https://developers.tiktok.com → Manage apps → your app

TIKTOK_CLIENT_KEY=your-tiktok-client-key                             # [REQUIRED]
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret                       # [REQUIRED]
SOCIAL_OAUTH_REDIRECT_URL_TIKTOK=http://localhost:3001/credentials/social/tiktok/callback    # [REQUIRED]

# ── Meta (Facebook & Instagram) OAuth ────────────────────────────────────────
# Get these from: https://developers.facebook.com → My Apps → your app
# Facebook and Instagram share the same Meta app credentials.
# Required permissions: pages_manage_posts, pages_read_engagement, pages_show_list
# Instagram also needs: instagram_basic, instagram_content_publish

FACEBOOK_APP_ID=your-facebook-app-id                                 # [REQUIRED]
FACEBOOK_APP_SECRET=your-facebook-app-secret                         # [REQUIRED]
SOCIAL_OAUTH_REDIRECT_URL_FACEBOOK=http://localhost:3001/credentials/social/facebook/callback  # [REQUIRED]
SOCIAL_OAUTH_REDIRECT_URL_INSTAGRAM=http://localhost:3001/credentials/social/instagram/callback # [REQUIRED]

# ── Cloudflare R2 (Video File Staging) ───────────────────────────────────────

R2_ACCESS_KEY_ID=your-r2-access-key-id                     # [REQUIRED]
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key             # [REQUIRED]
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com  # [REQUIRED]
R2_BUCKET_NAME=video-staging                               # [REQUIRED]

# ── OpenAI ────────────────────────────────────────────────────────────────────

PLATFORM_OPENAI_API_KEY=sk-your-platform-openai-api-key   # [REQUIRED]

# ── Next.js Public Variables ──────────────────────────────────────────────────
# Baked into the browser bundle at build time — do NOT put secrets here

NEXT_PUBLIC_API_BASE_URL=http://localhost/api              # [REQUIRED]

# ── Production-Only Variables ─────────────────────────────────────────────────

REGISTRY=ikcloudky6/automation                             # [PROD] Docker Hub repo
IMAGE_TAG=latest                                           # [PROD] set by CI/CD
APP_URL=https://yourdomain.com                             # [PROD]
EMAIL_REDIRECT_TO=https://yourdomain.com/verify-email      # [PROD]
PASSWORD_RESET_REDIRECT_URL=https://yourdomain.com/reset-password  # [PROD]
