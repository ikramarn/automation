# ══════════════════════════════════════════════════════════════════════════════
# AI Video Automation SaaS — Environment Variable Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env (development) or .env.prod (production).
# NEVER commit .env or .env.prod to version control.
#
# Required variables are marked [REQUIRED].
# Optional variables with sensible defaults are marked [OPTIONAL].
# Production-only variables are marked [PROD].

# ── Application ───────────────────────────────────────────────────────────────

# Public hostname for the application (used in email links, OAuth redirects)
# Example: app.example.com  or  localhost
DOMAIN=localhost                               # [REQUIRED] [PROD: your actual domain]

# Full public URL of the Next.js dashboard
# Used in transactional email links and OAuth redirect URLs
DASHBOARD_URL=http://localhost:3000            # [REQUIRED]

# Full public URL of the Fastify API (as seen from the public internet via Nginx)
# Used internally for constructing webhook and OAuth callback URLs
API_URL=http://localhost/api                   # [REQUIRED]

# ── Fastify API Server ────────────────────────────────────────────────────────

PORT=3001                                      # [OPTIONAL] API container listen port
HOST=0.0.0.0                                   # [OPTIONAL] Bind address (0.0.0.0 for Docker)
NODE_ENV=development                           # [REQUIRED] development | production | test

# Secret used to sign HttpOnly session cookies (min 32 chars, randomly generated)
# Generate with: openssl rand -hex 32
COOKIE_SECRET=replace-with-a-random-32-char-minimum-string  # [REQUIRED]

# Allowed CORS origins (comma-separated in production if multiple)
CORS_ORIGIN=http://localhost:3000              # [REQUIRED]

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Project URL (public — safe to expose to browser via NEXT_PUBLIC_*)
SUPABASE_URL=https://your-project-ref.supabase.co          # [REQUIRED]
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co  # [REQUIRED] Next.js client

# Anon/public key — safe to expose to browser (RLS enforces access control)
SUPABASE_ANON_KEY=your-supabase-anon-key                   # [REQUIRED] API server
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key       # [REQUIRED] Next.js client

# Service role key — SERVER SIDE ONLY, never expose to the browser
# Bypasses RLS — used by Backend API for vault access and admin operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # [REQUIRED]

# JWT secret — used to verify Supabase-issued session tokens
# Found in: Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-supabase-jwt-secret               # [REQUIRED]

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys

# Secret key — SERVER SIDE ONLY
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key           # [REQUIRED]

# Webhook signing secret — used to verify incoming Stripe webhook payloads
# Found in: Stripe Dashboard → Developers → Webhooks → (your endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret     # [REQUIRED]

# Stripe Price ID for the base subscription tier ($15–$29/month)
# Found in: Stripe Dashboard → Products → (your product) → Price ID
STRIPE_PRICE_ID=price_your-stripe-price-id                 # [REQUIRED]

# Stripe Checkout success / cancel redirect URLs
STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?checkout=success   # [REQUIRED]
STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?checkout=cancelled  # [REQUIRED]

# ── n8n Pipeline Engine ───────────────────────────────────────────────────────

# Internal service token — shared secret between Backend API and n8n
# n8n passes this in the Authorization header when calling /internal/* routes.
# Backend API validates it in serviceToken middleware (Req 18.5).
# Generate with: openssl rand -hex 32
N8N_SERVICE_TOKEN=replace-with-a-random-32-char-minimum-string  # [REQUIRED]

# n8n REST API key — Backend API uses this to create/trigger n8n workflows
# Found in: n8n Settings → API → Create API key (after n8n is running)
N8N_API_KEY=your-n8n-api-key                               # [REQUIRED]

# n8n REST API base URL (internal Docker network address)
# In Docker Compose: http://n8n:5678/api/v1
N8N_API_URL=http://n8n:5678/api/v1                         # [REQUIRED]

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Found in: resend.com → API Keys

RESEND_API_KEY=re_your-resend-api-key                      # [REQUIRED]

# Verified sender address (must be a domain you own with DKIM/SPF/DMARC configured)
RESEND_FROM_EMAIL=AI Video Automation <noreply@yourdomain.com>  # [REQUIRED]

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Found in: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Two OAuth clients are needed: one for user login, one for Google Drive access.

# OAuth client credentials (same client can be reused for both flows if scopes allow)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com   # [REQUIRED]
GOOGLE_CLIENT_SECRET=your-google-client-secret                       # [REQUIRED]

# Redirect URL registered in Google Cloud Console for the login OAuth flow
# Supabase Auth handles this callback: Settings → Auth → URL Configuration
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3001/auth/google/callback  # [REQUIRED]

# Redirect URL registered in Google Cloud Console for the Drive OAuth flow
# Handled by Backend API /credentials/google/callback route
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:3001/credentials/google/callback  # [REQUIRED]

# ── Cloudflare R2 (Video File Staging) ───────────────────────────────────────
# Found in: Cloudflare Dashboard → R2 → Manage R2 API Tokens

# R2 is S3-compatible; use @aws-sdk/client-s3 with R2 endpoint
R2_ACCESS_KEY_ID=your-r2-access-key-id                     # [REQUIRED]
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key             # [REQUIRED]

# R2 endpoint URL — format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com  # [REQUIRED]

# R2 bucket name for temporary video file staging (Req 9.6, 10.6)
R2_BUCKET_NAME=video-staging                               # [REQUIRED]

# ── Platform OpenAI API Key ───────────────────────────────────────────────────
# This is the PLATFORM-LEVEL fallback key used when a user has not provided
# their own OpenAI API key. It is used by the Script_Generator node in n8n.
# The user's own key (stored in Supabase Vault) takes precedence if present (Req 8.3).

PLATFORM_OPENAI_API_KEY=sk-your-platform-openai-api-key   # [REQUIRED]

# ── Next.js Public Variables ──────────────────────────────────────────────────
# Variables prefixed NEXT_PUBLIC_* are embedded in the browser bundle at build time.
# Do NOT put secrets here.

# Backend API base URL as seen by the browser (via Nginx)
# In Docker: the browser calls /api/* which Nginx routes to the API container
NEXT_PUBLIC_API_BASE_URL=http://localhost/api              # [REQUIRED]

# ── Production-Only Variables ─────────────────────────────────────────────────

# Docker image registry prefix (used in docker-compose.prod.yml)
# Example: ghcr.io/your-org
REGISTRY=ghcr.io/your-org                                  # [PROD]

# Docker image tag to deploy (set by CI/CD pipeline, e.g. git SHA or semver)
IMAGE_TAG=latest                                           # [PROD]

# Email redirect URLs (production values override localhost)
APP_URL=https://yourdomain.com                             # [PROD]
EMAIL_REDIRECT_TO=https://yourdomain.com/verify-email      # [PROD]
PASSWORD_RESET_REDIRECT_URL=https://yourdomain.com/reset-password  # [PROD]
