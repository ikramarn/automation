# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL — the Fastify API service (via Nginx)
# In Docker Compose this will be http://nginx/api or https://yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Server-side only — never expose to the browser
# Used only by Next.js server components / server actions that need elevated DB access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
